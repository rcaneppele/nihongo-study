{
  "name": "nihongo-study",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "description": "App pessoal de estudo de japonês: flash cards (SRS), treino de hiragana/katakana, módulo de Kanji e leitura extensiva.",
  "license": "MIT",
  "author": "Rodrigo da Silva Ferreira Caneppele <r.caneppele@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcaneppele/nihongo-study"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:kana-strokes": "node scripts/build-kana-strokes.mjs",
    "build:kanji-strokes": "node scripts/build-kanji-strokes.mjs",
    "test": "vitest run --project node",
    "typecheck": "tsc -b",
    "test:watch": "vitest --project node",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:browser && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:visual": "E2E_VISUAL=1 playwright test --project=visual",
    "test:visual:atualizar": "E2E_VISUAL=1 playwright test --project=visual --update-snapshots",
    "coverage": "vitest run --project node --coverage",
    "test:browser": "vitest run --project browser",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7",
    "vitest-browser-react": "^1.0.1"
  }
}
